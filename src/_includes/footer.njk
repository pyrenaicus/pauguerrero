<footer class="footer has-background-inherit">
  <div class="container">
    <div class="columns is-tablet">

            <!-- Column 1: Brand Profile & Location Entity -->
      <div class="column mb-5">
        <h2 class="is-size-6  mb-3">
          <a href="/" >Pau Guerrero</a>
        </h2>
        <p class=" is-size-7 mb-2">
          {{ languages[page.lang].footer.byLine }}
        </p>
        <p class=" is-size-7 mb-4">
          {{ languages[page.lang].footer.basedIn }}
        </p>
       {# <p class="is-size-7">
          <a href="mailto:info@pauguerrero.com" >
            info@pauguerrero.com
          </a>
        </p> #}
      </div>

            <!-- Column 2: Projects -->
      <div class="column mb-5">
        <h3 class="is-size-6  mb-3" style="letter-spacing: 0.1em;">
          Projects
        </h3>
        <ul class="is-size-7">
          <li class="py-1">
            <a href="{{ languages[page.lang].footer.projects.countArnau.url }}" >{{ languages[page.lang].footer.projects.countArnau.text }}</a>
          </li>
        </ul>
      </div>
            <!-- Column 3: Portfolios -->
      <div class="column mb-5">
        <h3 class="is-size-6  mb-3" style="letter-spacing: 0.1em;">
          Portfolios
        </h3>
        <ul class="is-size-7">
          <li class="py-1">
            <a href="{{ languages[page.lang].footer.architecturePhotography.url }}" >{{ languages[page.lang].footer.architecturePhotography.text }}</a>
          </li>
          {# <li class="py-1">
            <a href="{{ languages[page.lang].footer.retailPhotography.url }}" >{{ languages[page.lang].footer.retailPhotography.text }}</a>
          </li>
          <li class="py-1">
            <a href="{{ languages[page.lang].footer.fineArtPhotography.url }}" >{{ languages[page.lang].footer.fineArtPhotography.text }}</a>
          </li> #}
        </ul>
      </div>

            <!-- Column 4: Authority / Trust Signals -->
      <div class="column mb-5 is-narrow-tablet">
        <h3 class="is-size-6   mb-3" style="letter-spacing: 0.1em;">
          {{ languages[page.lang].information }}
        </h3>
        <ul class="is-size-7">
          <li class="py-1">
            <a href="{{ languages[page.lang].cv.url }}" >{{ languages[page.lang].cv.text }}</a>
          </li>
          <li class="py-1">
            <a href="{{ languages[page.lang].exhibitions.url }}" >{{ languages[page.lang].exhibitions.text }}</a>
          </li>
          <li class="py-1">
            <a href="{{ languages[page.lang].contact.url }}" >{{ languages[page.lang].contact.text }}</a>
          </li>
          <li class="py-1">
            <a href="{{ languages[page.lang].about.url }}" >{{ languages[page.lang].about.text }}</a>
          </li>
          <li class="py-1 mt-2">
            <a href="https://instagram.com/_pau_guerrero_/" class=" mr-4" target="_blank" rel="noopener">
              Instagram
            </a>
            <a href="https://mastodon.social/@pyrenaicus"  target="_blank" rel="noopener">
              Mastodon
            </a>
          </li>
        </ul>
      </div>

    </div>

        <!-- Divider Line -->
    <hr class="has-background-light my-5" style="height: 1px;">

    <!-- Bottom Row: Meta Links & Languages -->
    <div class="columns is-vcentered is-mobile is-multiline is-size-7">
      <div class="column is-12-mobile is-7-tablet">
        <div >
          <span class="mr-3">{{ languages[page.lang].footer.copyrightNotice }}</span>
          <a href="{{ languages[page.lang].privacyPolicy.url }}" class=" mr-3">{{ languages[page.lang].privacyPolicy.text }}</a>
          <a href="{{ languages[page.lang].termsOfService.url }}" >{{ languages[page.lang].termsOfService.text }}</a>
        </div>
      </div>

            <!-- Language Switcher -->
      <div class="column is-12-mobile is-5-tablet has-text-left-mobile has-text-right-tablet">
        <div class="languages">
          <p class="is-inline has-text-weight-bold  mr-3">{{ languages[page.lang].switchLang }}: </p>
          {% for link in page.url | locale_links %}

          <a href="{{ link.url }}" 
          lang="{{ link.lang }}"
          hreflang="{{ link.lang }}"
          class=" mr-3">
        {{ languages[link.lang].langName }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</footer>
