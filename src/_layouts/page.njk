---
layout: "base.njk"
---

<main id="main" class="flow">
  <article class="region page">
    <div class="wrapper flow prose">
      {% if not home %}
        <h1 class="category-title">{{ title }}</h1>
      {% endif %}
      {% if intro %}
        {{ intro | safe }}
        {% if images %}
         {% imagesShortcode images, imageCollection %}
         {% endif %}
         {{ content | safe }}
         {% else %}
         {{ content | safe }}
         {% imagesShortcode images, imageCollection %}
          {% endif %}
    </div>
  </article>
</main>
