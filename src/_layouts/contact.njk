---
layout: "base.njk"
---

<main id="main" class="container">
  <section class="section">
  </section>

<section class="section content">
  <div class="columns">
    <div class="column is-two-thirds-tablet is-half-desktop">
      
      <!-- Introduction Header & Copy -->
      <div class="content mb-6">
        <h2 class="title ">{{ languages[page.lang].contactForm.subtitle }}</h2>
        <p class="subtitle has-text-grey mt-2">
          {{ languages[page.lang].contactForm.text }}
        </p>
      </div>

      <!-- Contact Form Box -->
      <form action="https://api.web3forms.com/submit" name="contact" method="POST" class="box p-5 is-shadowless">
        <!-- Web3Forms Hidden Inputs -->
        <input
          type="hidden"
          name="access_key"
          value="2356652f-d928-4545-8e6c-bf03f9346266"
        />
        <input
          type="hidden"
          name="redirect"
          value="{{ meta.url }}/{{ page.lang }}/success/"
        />
        <input
          type="hidden"
          name="subject"
          value="pauguerrero {{ page.lang | upper }} contact form"
        />
        <!-- Honeypot (Spam Prevention) using Bulma's utility class -->
        <input type="checkbox" name="botcheck" class="is-hidden" style="display: none" />

        <!-- Name Field -->
        <div class="field mb-4">
          <label class="label has-text-grey">{{ languages[page.lang].contactForm.name }}</label>
          <div class="control">
            <input 
              class="input" 
              type="text" 
              name="name" 
              placeholder="{{ languages[page.lang].contactForm.placeholderName}}" 
              required 
            />
          </div>
        </div>

        <!-- Email Field -->
        <div class="field mb-4">
          <label class="label  has-text-grey">{{ languages[page.lang].contactForm.email }}</label>
          <div class="control">
            <input 
              class="input" 
              type="email" 
              name="email" 
              placeholder="{{ languages[page.lang].contactForm.placeholderEmail}}" 
              required 
            />
          </div>
        </div>

        <!-- Message Field -->
        <div class="field mb-5">
          <label class="label  has-text-grey">{{ languages[page.lang].contactForm.message }}</label>
          <div class="control">
            <textarea 
              class="textarea" 
              name="message" 
              rows="5" 
              placeholder="{{ languages[page.lang].contactForm.placeholderMessage }}" 
              required
            ></textarea>
          </div>
        </div>

<!-- Privacy Policy Consent Checkbox -->
        <div class="field mb-4">
          <div class="control">
            <label class="checkbox has-text-grey is-size-7">
              <input type="checkbox" id="privacy-checkbox" name="privacy_consent" required class="mr-2" />
              {{ languages[page.lang].contactForm.privacyText }}
              <a href="{{ languages[page.lang].privacyPolicy.url }}" target="_blank" class="has-text-dark is-underlined">
                {{ languages[page.lang].contactForm.privacyLink }}
              </a>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="field mt-5">
          <div class="control">
            <button id="submit-button" class="button is-fullwidth has-text-weight-semibold is-dark" type="submit" disabled>
              {{ languages[page.lang].contactForm.send }}
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
<section class="section is-medium"></section>
</main>

<!-- JavaScript to toggle the disabled state -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const checkbox = document.getElementById('privacy-checkbox');
    const submitBtn = document.getElementById('submit-button');

    checkbox.addEventListener('change', function() {
      // If checked, disabled is false. If unchecked, disabled is true.
      submitBtn.disabled = !this.checked;
    });
  });
</script>